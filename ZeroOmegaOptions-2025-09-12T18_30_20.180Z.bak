{"+__ruleListOf_auto switch":{"color":"#99dd99","defaultProfileName":"direct","format":"AutoProxy","lastUpdate":null,"matchProfileName":"proxy","name":"__ruleListOf_auto switch","pacScript":"var FindProxyForURL = function(init, profiles) {\n    return function(url, host) {\n        \"use strict\";\n        var result = init, scheme = url.substr(0, url.indexOf(\":\"));\n        do {\n            if (!profiles[result]) return result;\n            result = profiles[result];\n            if (typeof result === \"function\") result = result(url, host, scheme);\n        } while (typeof result !== \"string\" || result.charCodeAt(0) === 43);\n        return result;\n    };\n}(\"+__tempZeroRuleListPac\", {\n    \"+__tempZeroRuleListPac\": \"DIRECT\"\n});","profileType":"RuleListProfile","revision":"1993f311f3f","ruleList":"","sha256":"c9a51864cdba0dcb63efc5268d91e19204fc76e28eb91d02f0cbdefc13c31e20","sourceUrl":"https://raw.githubusercontent.com/gfwlist/gfwlist/master/gfwlist.txt"},"+auto switch":{"color":"#99dd99","defaultProfileName":"__ruleListOf_auto switch","name":"auto switch","profileType":"SwitchProfile","revision":"19845efda83","rules":[]},"+proxy":{"bypassList":[{"conditionType":"BypassCondition","pattern":"127.0.0.1"},{"conditionType":"BypassCondition","pattern":"::1"},{"conditionType":"BypassCondition","pattern":"localhost"}],"color":"#99ccee","fallbackProxy":{"host":"127.0.0.1","port":10808,"scheme":"socks5"},"name":"proxy","profileType":"FixedProfile","revision":"19845ef9fb2"},"-addConditionsToBottom":false,"-confirmDeletion":false,"-downloadInterval":1440,"-enableQuickSwitch":true,"-monitorWebRequests":false,"-quickSwitchProfiles":["auto switch","proxy","direct"],"-refreshOnProfileChange":false,"-revertProxyChanges":true,"-showExternalProfile":false,"-showInspectMenu":false,"-showResultProfileOnActionBadgeText":false,"-startupProfileName":"auto switch","schemaVersion":2}